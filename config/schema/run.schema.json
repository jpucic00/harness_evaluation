{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "time_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 900,
          "title": "Time Limit"
        },
        "working_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Working Limit"
        },
        "token_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Limit"
        },
        "message_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Limit"
        },
        "cost_limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Limit"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "SuiteSelection": {
      "title": "SuiteSelection",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "containment",
              "title": "Name",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/ContainmentOptions"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "capability",
              "title": "Name",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/CapabilityOptions"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "injection",
              "title": "Name",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/InjectionOptions"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "ContainmentOptions": {
      "additionalProperties": false,
      "description": "The containment suite takes no options.",
      "properties": {},
      "title": "ContainmentOptions",
      "type": "object"
    },
    "CapabilityOptions": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "At most this many tasks (easiest first).",
          "title": "Limit"
        },
        "ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "default": null,
          "description": "Only these task ids (folder names in ``cases/capability/``).",
          "title": "Ids"
        }
      },
      "title": "CapabilityOptions",
      "type": "object"
    },
    "InjectionOptions": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "vectors": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "issue_text",
                  "code_comment",
                  "readme",
                  "config_file"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "default": null,
          "description": "Injection vectors to include (benign samples are always included).",
          "title": "Vectors"
        },
        "severities": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "S1",
                  "S2",
                  "S3"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "default": null,
          "title": "Severities"
        },
        "defense_prompt": {
          "default": true,
          "description": "Use CodeIPI's system prompt that warns about instructions found in files.",
          "title": "Defense Prompt",
          "type": "boolean"
        },
        "agent_user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "User the harness runs as (default: the environment's ``agent_user``).",
          "title": "Agent User"
        },
        "codeipi": {
          "default": true,
          "description": "Include CodeIPI's 45 published samples.",
          "title": "Codeipi",
          "type": "boolean"
        },
        "local": {
          "default": true,
          "description": "Include the local cases in ``cases/injection/``.",
          "title": "Local",
          "type": "boolean"
        },
        "ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "default": null,
          "description": "Only these sample ids (CodeIPI or local).",
          "title": "Ids"
        }
      },
      "title": "InjectionOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "models": {
      "items": {
        "type": "string"
      },
      "title": "Models",
      "type": "array"
    },
    "harnesses": {
      "items": {
        "type": "string"
      },
      "title": "Harnesses",
      "type": "array"
    },
    "environments": {
      "items": {
        "type": "string"
      },
      "title": "Environments",
      "type": "array"
    },
    "suites": {
      "items": {
        "anyOf": [
          {
            "enum": [
              "containment",
              "capability",
              "injection"
            ],
            "type": "string"
          },
          {
            "$ref": "#/$defs/SuiteSelection"
          }
        ]
      },
      "title": "Suites",
      "type": "array"
    },
    "epochs": {
      "default": 1,
      "minimum": 1,
      "title": "Epochs",
      "type": "integer"
    },
    "max_samples": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Concurrent samples per task (defaults to the environment's max_concurrent).",
      "title": "Max Samples"
    },
    "max_tasks": {
      "default": 1,
      "minimum": 1,
      "title": "Max Tasks",
      "type": "integer"
    },
    "subagent_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model profile that serves the subagents of every harness that has them,\nreplacing each harness's ``subagents.model`` (e.g. a mock model for smoke runs).",
      "title": "Subagent Model"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "retry_attempts": {
      "default": 1,
      "minimum": 0,
      "title": "Retry Attempts",
      "type": "integer"
    },
    "fail_on_error": {
      "default": 0.5,
      "minimum": 0,
      "title": "Fail On Error",
      "type": "number"
    },
    "log_dir": {
      "default": "logs",
      "title": "Log Dir",
      "type": "string"
    },
    "report_dir": {
      "default": "reports",
      "title": "Report Dir",
      "type": "string"
    },
    "resource_interval": {
      "default": 2.0,
      "description": "Seconds between host CPU/memory readings for the report's Resources section; 0 = off.",
      "minimum": 0,
      "title": "Resource Interval",
      "type": "number"
    }
  },
  "required": [
    "models",
    "harnesses",
    "environments",
    "suites"
  ],
  "title": "RunConfig",
  "type": "object"
}
